# PDF-Editor-App — Beispiel-Konfiguration (nach /etc/pdf-editor/env bzw. .env kopieren)

# --- Pflicht (compose bricht ohne diese Werte ab) ---
# Erzeugen mit: openssl rand -hex 32
PDFAPP_SECRET_KEY=
PDFAPP_DB_PASSWORD=

# --- Admin-Seed (optional): legt beim ersten Start einen Admin an ---
PDFAPP_ADMIN_EMAIL=
PDFAPP_ADMIN_PASSWORD=

# --- Datei-Limits ---
PDFAPP_MAX_FILE_SIZE_MB=50            # anonym, pro Datei
PDFAPP_MAX_TOTAL_SIZE_MB=200          # anonym, pro Multi-Datei-Operation
PDFAPP_MAX_FILE_SIZE_MB_AUTHED=100    # angemeldet, pro Datei
PDFAPP_MAX_TOTAL_SIZE_MB_AUTHED=400   # angemeldet, pro Operation

# --- Rate-Limits (slowapi-Syntax, mehrere mit ; getrennt) ---
PDFAPP_RATE_LIMIT_DEFAULT=30/minute;500/day
PDFAPP_RATE_LIMIT_AUTHED=60/minute;2000/day
PDFAPP_RATE_LIMIT_MAIL=5/hour

# --- Mailversand: leer lassen = Feature deaktiviert (Endpoint antwortet 503) ---
PDFAPP_SMTP_HOST=
PDFAPP_SMTP_PORT=587
PDFAPP_SMTP_USER=
PDFAPP_SMTP_PASSWORD=
PDFAPP_SMTP_FROM=noreply@flowaudit.de

# --- Konto-Flows (E-Mail-Verifikation + Passwort-Reset) ---
# Beide Werte gesetzt (plus SMTP) = Flows aktiv; Links zeigen auf diese URL
PDFAPP_PUBLIC_BASE_URL=

# --- HSTS (nur setzen, wenn der Dienst NUR über HTTPS erreichbar ist) ---
# Erzwingt im Browser künftige HTTPS-Aufrufe. 0 = aus. Produktiv: 15768000.
# Achtung: Einmal gesetzt, merkt der Browser das für die Dauer der Angabe —
# ein späterer HTTP-Zugriff auf dieselbe Domain ist dann nicht mehr möglich.
PDFAPP_HSTS_SECONDS=0

# --- Quelltext-Adresse (Pflicht bei AGPL-Komponenten) ---
# PyMuPDF und Ghostscript stehen unter der GNU Affero GPL. Deren Lizenz
# verlangt, dass Nutzerinnen und Nutzer des Netzdienstes den Quelltext
# erhalten. Ohne diesen Wert weist die Lizenzseite den Betreiber sichtbar
# darauf hin, dass die Bedingung noch nicht erfüllt ist.
PDFAPP_SOURCE_URL=https://github.com/janpow77/audit_designer

# --- Lokale KI (optional): OpenAI-kompatibler Endpoint der EIGENEN Infrastruktur ---
# z.B. http://ai-router:7842/v1 — leer = KI-Funktionen deaktiviert. Keine Cloud.
PDFAPP_LLM_URL=
PDFAPP_LLM_MODEL=qwen3.5:35b

# --- Cloudflare Turnstile (optional, Bot-Schutz für Registrierung + Mailversand) ---
PDFAPP_TURNSTILE_SITE_KEY=
PDFAPP_TURNSTILE_SECRET=

# CF-Connecting-IP vertrauen — NUR true, wenn das Backend ausschließlich
# über den Cloudflare-Tunnel erreichbar ist (sonst Rate-Limit-Umgehung)
PDFAPP_TRUST_CF_HEADER=false

# --- Container-Bilder aus GHCR (BETRIEB.md, Teil B4) ---
# latest = letzter Stand von main. Für einen Rückfall den Commit-SHA eines
# früheren Standes eintragen, dann: compose pull && compose up -d
PDFAPP_IMAGE_TAG=latest

# --- Cloudflare-Tunnel (nur Produktion, compose-Profil "prod") ---
TUNNEL_TOKEN=
